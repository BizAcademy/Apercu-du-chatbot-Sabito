# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
/.sabito-runtime/
/.sabito-deploy.json

# Exclude local agent context and troubleshooting material from publication.
/.agents/
/attached_assets/
/screenshots/
/test-results/
/playwright-report/
.env
.env.*
!.env.example
