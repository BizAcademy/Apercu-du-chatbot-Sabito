diff --git a/app/Services/Sabito/SabitoJobContract.php b/app/Services/Sabito/SabitoJobContract.php
new file mode 100644
index 0000000..cc182c6
--- /dev/null
+++ b/app/Services/Sabito/SabitoJobContract.php
@@ -0,0 +1,84 @@
+<?php
+
+namespace App\Services\Sabito;
+
+use InvalidArgumentException;
+
+/** Explicit widget-to-model lookup contract. Values are never guessed by format. */
+final class SabitoJobContract
+{
+    public const FIELDS = [
+        'account_activation' => ['transaction_id', 'reference'],
+        'deposit_status' => ['deposit_number', 'reference'],
+        'withdrawal_status' => ['withdrawal_number', 'reference'],
+        'transfer_status' => ['transfer_reference', 'reference'],
+        'wallet_swap_status' => ['swap_reference', 'public_id'],
+        'wallet_balance' => null,
+        'referral_code' => null,
+        'referral_commission_status' => ['commission_reference', 'commission_id'],
+        'leader_reward_status' => ['reward_period', 'period_start'],
+        'formation_payment_status' => ['payment_reference', 'reference'],
+        'digital_purchase_status' => ['purchase_reference', 'transaction_id'],
+        'digital_sale_status' => ['sale_reference', 'transaction_id'],
+        'digital_subscription_status' => ['subscription_reference', 'transaction_id'],
+        'digital_store_fee_status' => ['fee_reference', 'reference'],
+        'refund_status' => ['purchase_reference', 'purchase_reference'],
+        'ads_campaign_status' => ['campaign_reference', 'campaign_id'],
+        'ads_payout_status' => ['publication_reference', 'publication_day_id'],
+        'wallet_movement_status' => ['transaction_id', 'reference'],
+    ];
+
+    public static function fields(string $operation, array $fields): array
+    {
+        if (! array_key_exists($operation, self::FIELDS)) {
+            throw new InvalidArgumentException('operation');
+        }
+        $contract = self::FIELDS[$operation];
+        // Preserve old server clients, but never combine two lookup contracts.
+        if ($contract === null) {
+            if ($fields !== []) {
+                throw new InvalidArgumentException('fields');
+            }
+            return [];
+        }
+        [$public, $internal] = $contract;
+        if (! array_key_exists($public, $fields)) {
+            $legacy = match ($operation) {
+                'account_activation' => [],
+                'wallet_swap_status' => ['swap_id', 'reference', 'idempotency_key'],
+                'referral_commission_status' => ['commission_id', 'transaction_id'],
+                'leader_reward_status' => ['reward_id', 'period_start'],
+                'digital_purchase_status', 'digital_sale_status', 'refund_status' => ['purchase_id', 'transaction_id', 'reference', 'external_reference'],
+                'digital_subscription_status' => ['subscription_id', 'transaction_id'],
+                'ads_campaign_status' => ['campaign_id'],
+                'ads_payout_status' => ['publication_day_id'],
+                default => ['reference', 'external_reference'],
+            };
+            if ($operation === 'account_activation' && $fields === []) {
+                return [];
+            }
+            if (count($fields) !== 1 || array_diff(array_keys($fields), $legacy)) {
+                throw new InvalidArgumentException($public);
+            }
+            $value = reset($fields);
+            if (! is_string($value) && ! is_int($value) || trim((string) $value) === '' || strlen((string) $value) > 128) {
+                throw new InvalidArgumentException($public);
+            }
+            return $fields;
+        }
+        if (count($fields) !== 1 || ! is_string($fields[$public]) || trim($fields[$public]) === '' || strlen($fields[$public]) > 128) {
+            throw new InvalidArgumentException($public);
+        }
+        $value = $fields[$public];
+        if (in_array($internal, ['commission_id', 'campaign_id', 'publication_day_id', 'transaction_id', 'purchase_reference'], true) &&
+            (! preg_match('/^[1-9][0-9]{0,17}$/D', $value))) {
+            throw new InvalidArgumentException($public);
+        }
+        if ($internal === 'period_start' &&
+            (! preg_match('/^([0-9]{4})-([0-9]{2})-01$/D', $value, $parts) ||
+                ! checkdate((int) $parts[2], 1, (int) $parts[1]))) {
+            throw new InvalidArgumentException($public);
+        }
+        return [$internal => $value];
+    }
+}
