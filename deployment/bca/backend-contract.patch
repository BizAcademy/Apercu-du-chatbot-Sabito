diff --git a/tests/Feature/SabitoReadContractCases.php b/tests/Feature/SabitoReadContractCases.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/SabitoReadContractCases.php
@@ -0,0 +1,127 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use App\Services\Sabito\SabitoJobContract;
+use App\Services\Sabito\SabitoReadOnlyJobService;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+trait SabitoReadContractCases
+{
+    public function test_all_eighteen_public_contracts_read_owned_fixtures_without_any_write(): void
+    {
+        $user = User::create(['name' => 'Fixture', 'email' => 'contract@fixture.test',
+            'password' => 'fixture-only', 'is_active' => true, 'sponsor_code' => 'FIXTURE']);
+        $id = $user->id;
+        $other = User::create(['name'=>'Other fixture','email'=>'other@fixture.test',
+            'password'=>'fixture-only','is_active'=>true,'sponsor_code'=>'OTHER']);
+        // Use the real models/queries on a throwaway SQLite database, not mock results.
+        foreach ([
+            'wallet_swaps' => ['user_id','public_id','idempotency_key','status','direction','source_amount','source_currency','fee_amount','destination_amount','destination_currency','completed_at'],
+            'affiliate_commissions' => ['sponsor_id','transaction_id','status','level','amount','paid_at'],
+            'monthly_top_leader_rewards' => ['user_id','period_start','category','tier','rank','sales_count','status','cash_transaction_id'],
+            'bca_ads_campaigns' => ['advertiser_id','title','status','budget_amount','submitted_currency','target_paid_views','starts_at','ends_at'],
+            'bca_ads_publication_days' => ['publisher_id','status','day_number','validated_views','tracking_clicks','validated_at'],
+        ] as $table => $columns) {
+            Schema::create($table, function (Blueprint $t) use ($columns): void {
+                $t->id();
+                foreach ($columns as $column) {
+                    $t->string($column)->nullable();
+                }
+                $t->timestamps();
+            });
+        }
+        $references = [];
+        foreach (['activation','deposit','withdrawal','formation','digital_store_fee','movement','transfer','refund'] as $type) {
+            $reference = 'FIX-'.$type;
+            DB::table('transactions')->insert(['user_id'=>$id,'amount'=>100,
+                'type'=>$type === 'transfer' ? 'withdrawal' : $type,'status'=>'completed','reference'=>$reference,
+                'payment_method'=>$type === 'transfer' ? 'bca_transfer' : null,
+                'metadata'=>json_encode($type === 'refund' ? ['purchase_id'=>1] : []),
+                'created_at'=>now(),'updated_at'=>now()]);
+            $references[$type] = $reference;
+        }
+        DB::table('digital_products')->insert(['id'=>1,'user_id'=>$id,'title'=>'Fixture']);
+        DB::table('product_purchases')->insert(['id'=>1,'product_id'=>1,'buyer_id'=>$id,'seller_id'=>$id,
+            'amount'=>100,'currency'=>'XAF','status'=>'completed','transaction_id'=>1001,'created_at'=>now()]);
+        DB::table('digital_store_subscriptions')->insert(['user_id'=>$id,'transaction_id'=>1002,
+            'plan_type'=>'annual','amount'=>100,'status'=>'active','start_date'=>now()->subDay(),'end_date'=>now()->addYear()]);
+        DB::table('wallet_swaps')->insert(['user_id'=>$id,'public_id'=>'SWAP','status'=>'completed',
+            'source_amount'=>'1','fee_amount'=>'0','destination_amount'=>'600','source_currency'=>'USD','destination_currency'=>'XAF']);
+        DB::table('affiliate_commissions')->insert(['sponsor_id'=>$id,'transaction_id'=>'COM','status'=>'completed','level'=>'1','amount'=>'100']);
+        DB::table('monthly_top_leader_rewards')->insert(['user_id'=>$id,'period_start'=>'2026-11-01',
+            'status'=>'fulfilled','category'=>'simple','rank'=>'1','sales_count'=>'10']);
+        DB::table('bca_ads_campaigns')->insert(['advertiser_id'=>$id,'title'=>'Fixture','status'=>'active',
+            'budget_amount'=>'100','submitted_currency'=>'XAF','target_paid_views'=>'10']);
+        DB::table('bca_ads_publication_days')->insert(['publisher_id'=>$id,'status'=>'pending',
+            'day_number'=>'1','validated_views'=>'0','tracking_clicks'=>'0']);
+        $values = [
+            'account_activation'=>'FIX-activation','deposit_status'=>'FIX-deposit','withdrawal_status'=>'FIX-withdrawal',
+            'transfer_status'=>'FIX-transfer','wallet_swap_status'=>'SWAP','wallet_balance'=>null,'referral_code'=>null,
+            'referral_commission_status'=>'1','leader_reward_status'=>'2026-11-01','formation_payment_status'=>'FIX-formation',
+            'digital_purchase_status'=>'1001','digital_sale_status'=>'1001','digital_subscription_status'=>'1002',
+            'digital_store_fee_status'=>'FIX-digital_store_fee','refund_status'=>'1001',
+            'ads_campaign_status'=>'1','ads_payout_status'=>'1','wallet_movement_status'=>'FIX-movement',
+        ];
+        $service = app(SabitoReadOnlyJobService::class);
+        foreach ($values as $operation => $value) {
+            $field = SabitoJobContract::FIELDS[$operation][0] ?? null;
+            $job = ['operation'=>$operation,'external_user_id'=>(string)$id,
+                'fields'=>$field ? [$field=>$value] : [],'expires_at'=>now()->addMinute()->toIso8601String()];
+            $writes = [];
+            DB::listen(function ($query) use (&$writes): void {
+                if (preg_match('/^\s*(insert|update|delete|replace|alter|drop)\b/i', $query->sql)) {
+                    $writes[] = 'write';
+                }
+            });
+            $result = $service->handle($job);
+            $this->assertContains($result['status'], ['ok','confirmed','active','pending'], $operation);
+            $this->assertNotEmpty($result['data']['statut'], $operation);
+            $this->assertSame([], $writes, $operation.' must not write');
+            if ($field) {
+                $foreign = $job;
+                $foreign['external_user_id'] = (string)$other->id;
+                $this->assertContains($service->handle($foreign)['status'], ['not_found','invalid_input'], $operation.' denies another existing member’s reference');
+            }
+            $job['external_user_id'] = '999999';
+            $this->assertSame('forbidden', $service->handle($job)['status'], $operation);
+            $job['external_user_id'] = (string)$id;
+            $job['expires_at'] = now()->subMinute()->toIso8601String();
+            $this->assertSame('error', $service->handle($job)['status'], $operation);
+            if ($field) {
+                $job['expires_at'] = now()->addMinute()->toIso8601String();
+                $job['fields'] = [$field=>'NOT-A-REFERENCE'];
+                $this->assertContains($service->handle($job)['status'], ['not_found','invalid_input'], $operation);
+            }
+        }
+        $job = ['operation'=>'deposit_status','external_user_id'=>(string)$id,
+            'fields'=>['deposit_number'=>'FIX-deposit','user_id'=>'999'],
+            'expires_at'=>now()->addMinute()->toIso8601String()];
+        $this->assertSame('invalid_input', $service->handle($job)['status']);
+        foreach (SabitoReadOnlyJobService::OPERATIONS as $operation) {
+            if (in_array($operation, ['digital_product_review','referral_commissions_recent','ads_publisher_status','bca_catalogue_current'], true)) continue;
+            [$field] = SabitoJobContract::FIELDS[$operation];
+            $table = match ($operation) {
+                'wallet_swap_status'=>'wallet_swaps', 'wallet_balance'=>'user_balances',
+                'referral_code'=>'users', 'referral_commission_status'=>'affiliate_commissions',
+                'leader_reward_status'=>'monthly_top_leader_rewards',
+                'digital_purchase_status','digital_sale_status','refund_status'=>'product_purchases',
+                'digital_subscription_status'=>'digital_store_subscriptions',
+                'ads_campaign_status'=>'bca_ads_campaigns','ads_payout_status'=>'bca_ads_publication_days',
+                default=>'transactions',
+            };
+            $job = ['operation'=>$operation,'external_user_id'=>(string)$id,
+                'fields'=>$field ? [$field=>$values[$operation]] : [],
+                'expires_at'=>now()->addMinute()->toIso8601String()];
+            Schema::rename($table, $table.'_unavailable_fixture');
+            try {
+                $this->assertSame('error', $service->handle($job)['status'], $operation.' real query failure stays technical');
+            } finally {
+                Schema::rename($table.'_unavailable_fixture', $table);
+            }
+        }
+    }
+}
diff --git a/app/Services/Sabito/SabitoSupportReadService.php b/app/Services/Sabito/SabitoSupportReadService.php
new file mode 100644
--- /dev/null
+++ b/app/Services/Sabito/SabitoSupportReadService.php
@@ -0,0 +1,104 @@
+<?php
+
+namespace App\Services\Sabito;
+
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+/** Called only after SabitoReadOnlyJobService verifies identity, expiry and
+ * the explicit field contract. All queries are bounded and read-only. */
+final class SabitoSupportReadService
+{
+    public function handle(User $user, string $operation, array $fields): array
+    {
+        return match ($operation) {
+            'digital_product_review' => $this->product($user, $fields),
+            'referral_commissions_recent' => $this->commissions($user),
+            'ads_publisher_status' => $this->publisher($user),
+            'bca_catalogue_current' => $this->catalogue(),
+            default => ['status' => 'forbidden'],
+        };
+    }
+
+    private function text(mixed $value, int $length = 160): string
+    {
+        return mb_substr(trim(preg_replace('/[\x00-\x1f\x7f]+/u', ' ', (string) $value)), 0, $length);
+    }
+
+    private function product(User $user, array $fields): array
+    {
+        $product = DB::table('digital_products')->where('user_id', $user->id)
+            ->where('id', $fields['product_id'])->first(['id', 'title', 'status', 'rejection_reason']);
+        if (! $product) {
+            return ['status' => 'not_found'];
+        }
+        if (! in_array($product->status, ['pending', 'approved', 'rejected'], true)) {
+            return ['status' => 'error'];
+        }
+        return ['status' => $product->status === 'pending' ? 'pending' : 'ok', 'data' => [
+            'statut' => $product->status, 'reference' => (string) $product->id,
+            'produit' => $this->text($product->title),
+            'motif' => $product->status === 'rejected' && $product->rejection_reason !== null ?
+                $this->text($product->rejection_reason, 1000) : null,
+        ]];
+    }
+
+    private function commissions(User $user): array
+    {
+        $rows = DB::table('affiliate_commissions')->where('sponsor_id', $user->id)
+            ->orderByDesc('id')->limit(6)->get(['id', 'level', 'amount', 'status', 'paid_at']);
+        if ($rows->isEmpty()) {
+            return ['status' => 'not_found'];
+        }
+        $lines = $rows->take(5)->map(fn ($row) => 'Commission '.$row->id.' — niveau '.
+            $this->text($row->level, 8).' — montant enregistré '.$this->text($row->amount, 30).
+            ' — statut '.$this->text($row->status, 40).
+            ($row->paid_at ? ' — date enregistrée '.$this->text($row->paid_at, 40) : ''))->implode("\n");
+        return ['status' => 'ok', 'data' => [
+            'statut' => 'consultation effectuée', 'nombre' => min(5, $rows->count()),
+            'commissions' => $lines, 'liste_limitee' => $rows->count() > 5,
+        ]];
+    }
+
+    private function publisher(User $user): array
+    {
+        $profile = DB::table('bca_ads_publisher_profiles')->where('user_id', $user->id)
+            ->first(['status', 'test_campaign_validated', 'blocked_reason']);
+        if (! $profile) {
+            return ['status' => 'not_found'];
+        }
+        // Do not substitute the archived application's default tariff for an
+        // actual setting. A missing setting remains explicitly unavailable.
+        $rate = DB::table('settings')->where('key', 'bca_ads_publisher_rate_per_view')->value('value');
+        $rate = is_numeric($rate) && is_finite((float) $rate) && (float) $rate >= 0 ? (float) $rate : null;
+        return ['status' => 'ok', 'data' => [
+            'statut' => $this->text($profile->status, 40),
+            'test_valide' => (bool) $profile->test_campaign_validated,
+            'motif_blocage' => $profile->status === 'blocked' ? $this->text($profile->blocked_reason, 800) : null,
+            'taux_configure' => $rate,
+            'precision_tarif' => $rate === null ? 'Paramètre absent : aucun taux actuel confirmé.' :
+                'Paramètre global enregistré ; consulter aussi les conditions de la campagne courante.',
+        ]];
+    }
+
+    private function catalogue(): array
+    {
+        $groups = [
+            'Formations' => DB::table('formations')->where('is_active', true),
+            'Ebooks' => DB::table('ebooks')->where('is_active', true),
+            'Digital Store' => DB::table('digital_products')->where('is_active', true)->where('status', 'approved'),
+        ];
+        $lines = [];
+        $limited = false;
+        foreach ($groups as $label => $query) {
+            $rows = $query->orderBy('id')->limit(6)->get(['title']);
+            $limited = $limited || $rows->count() > 5;
+            $lines[] = $label.' : '.($rows->isEmpty() ? 'aucune offre publiée renvoyée' :
+                $rows->take(5)->map(fn ($row) => $this->text($row->title, 90))->implode(' ; '));
+        }
+        return ['status' => 'ok', 'data' => [
+            'statut' => 'consultation effectuée', 'catalogue' => implode("\n", $lines),
+            'liste_limitee' => $limited,
+        ]];
+    }
+}
diff --git a/tests/Feature/SabitoSupportReadCases.php b/tests/Feature/SabitoSupportReadCases.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/SabitoSupportReadCases.php
@@ -0,0 +1,84 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use App\Services\Sabito\SabitoReadOnlyJobService;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+trait SabitoSupportReadCases
+{
+    public function test_support_reads_are_owned_bounded_and_never_write(): void
+    {
+        $owner = User::create(['name'=>'Owner','email'=>'support-owner@fixture.test',
+            'password'=>'fixture-only','is_active'=>true,'sponsor_code'=>'OWNER']);
+        $other = User::create(['name'=>'Other','email'=>'support-other@fixture.test',
+            'password'=>'fixture-only','is_active'=>true,'sponsor_code'=>'OTHER']);
+        Schema::table('digital_products', fn (Blueprint $t) => $t->text('rejection_reason')->nullable());
+        foreach ([
+            'affiliate_commissions'=>['sponsor_id','level','amount','status','paid_at'],
+            'bca_ads_publisher_profiles'=>['user_id','status','test_campaign_validated','blocked_reason'],
+            'ebooks'=>['title','is_active'],
+        ] as $table=>$columns) {
+            Schema::create($table, function (Blueprint $t) use ($columns): void {
+                $t->id();
+                foreach ($columns as $column) $t->string($column)->nullable();
+            });
+        }
+        DB::table('digital_products')->insert([
+            ['id'=>1,'user_id'=>$owner->id,'title'=>'Owned product','status'=>'pending','rejection_reason'=>null],
+            ['id'=>2,'user_id'=>$other->id,'title'=>'OTHER PRIVATE PRODUCT','status'=>'rejected','rejection_reason'=>'OTHER PRIVATE REASON'],
+            ['id'=>3,'user_id'=>$owner->id,'title'=>'Owned rejected','status'=>'rejected','rejection_reason'=>'Lien inaccessible'],
+            ['id'=>4,'user_id'=>$owner->id,'title'=>'Missing reason','status'=>'rejected','rejection_reason'=>null],
+        ]);
+        DB::table('affiliate_commissions')->insert([
+            ['sponsor_id'=>$owner->id,'level'=>1,'amount'=>23,'status'=>'paid'],
+            ['sponsor_id'=>$other->id,'level'=>2,'amount'=>999,'status'=>'SECRET_OTHER_COMMISSION'],
+        ]);
+        DB::table('bca_ads_publisher_profiles')->insert([
+            'user_id'=>$owner->id,'status'=>'active','test_campaign_validated'=>1,
+        ]);
+        DB::table('settings')->insert(['key'=>'bca_ads_publisher_rate_per_view','value'=>'0.6']);
+        DB::table('formations')->insert(['title'=>'Public course']);
+        DB::table('ebooks')->insert([['title'=>'Public ebook','is_active'=>1],['title'=>'HIDDEN EBOOK','is_active'=>0]]);
+        $service = new SabitoReadOnlyJobService;
+        $read = fn ($op, $fields = [], $member = null) => $service->handle([
+            'operation'=>$op,'external_user_id'=>(string)($member ?? $owner->id),'fields'=>$fields,
+            'expires_at'=>now()->addMinute()->toIso8601String(),
+        ]);
+        $writes = [];
+        DB::listen(function ($query) use (&$writes): void {
+            if (preg_match('/^\s*(insert|update|delete|replace|alter|drop|create)\b/i', $query->sql)) $writes[] = $query->sql;
+        });
+        $this->assertSame('pending', $read('digital_product_review',['product_reference'=>'1'])['data']['statut']);
+        $this->assertSame('Lien inaccessible', $read('digital_product_review',['product_reference'=>'3'])['data']['motif']);
+        $this->assertNull($read('digital_product_review',['product_reference'=>'4'])['data']['motif']);
+        $foreign = $read('digital_product_review',['product_reference'=>'2']);
+        $this->assertSame('not_found', $foreign['status']);
+        $this->assertArrayNotHasKey('data', $foreign);
+        $this->assertSame('invalid_input', $read('digital_product_review',['product_reference'=>'bad'])['status']);
+        $this->assertSame('invalid_input', $read('digital_product_review',['product_reference'=>'1','user_id'=>(string)$other->id])['status']);
+        $commissions = $read('referral_commissions_recent');
+        $this->assertSame(1, $commissions['data']['nombre']);
+        $this->assertStringNotContainsString('SECRET_OTHER', json_encode($commissions));
+        $this->assertSame('forbidden', $read('referral_commissions_recent', [], 999999)['status']);
+        $this->assertTrue($read('ads_publisher_status')['data']['test_valide']);
+        $this->assertSame(0.6, $read('ads_publisher_status')['data']['taux_configure']);
+        $this->assertSame('not_found', $read('ads_publisher_status', [], $other->id)['status']);
+        $catalogue = $read('bca_catalogue_current');
+        $this->assertStringContainsString('Public course', $catalogue['data']['catalogue']);
+        $this->assertStringContainsString('Public ebook', $catalogue['data']['catalogue']);
+        $this->assertStringNotContainsString('HIDDEN', $catalogue['data']['catalogue']);
+        $this->assertStringNotContainsString('PRIVATE', $catalogue['data']['catalogue']);
+        foreach (['digital_product_review','referral_commissions_recent','ads_publisher_status','bca_catalogue_current'] as $operation) {
+            $this->assertSame('forbidden', $read($operation, [], 999999)['status']);
+            $this->assertSame('invalid_input', $read($operation, ['user_id'=>(string)$other->id])['status']);
+        }
+        $this->assertSame([], $writes);
+        // Simulated unavailable storage must not become a successful empty result.
+        Schema::drop('affiliate_commissions');
+        $this->assertSame('error', $read('referral_commissions_recent')['status']);
+    }
+}
