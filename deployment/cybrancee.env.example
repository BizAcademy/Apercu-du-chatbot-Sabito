# EXAMPLE ONLY. Set real values in Plesk's custom environment variables.
# Never upload real credentials into the Git repository or public/ directory.
# MySQL and MariaDB. localhost is valid only on the database's own server.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=REPLACE_WITH_YOUR_DATABASE_NAME
MYSQL_USER=REPLACE_WITH_YOUR_DATABASE_USER
# Actual password: do NOT URL-encode special characters here.
MYSQL_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
ADMIN_API_KEY=REPLACE_WITH_YOUR_ADMIN_KEY_AT_LEAST_32_CHARS
JWT_SECRET=REPLACE_WITH_YOUR_JWT_KEY_AT_LEAST_32_CHARS
CLIENT_SECRET_PEPPER=REPLACE_WITH_YOUR_PEPPER_AT_LEAST_32_CHARS
PUBLIC_URL=https://sabito.bizconnectacademy.com
# Include the Sabito origin and actual BCA frontend origin (no trailing slash).
CORS_ORIGINS=https://sabito.bizconnectacademy.com
SABITO_AI_ENABLED=false
